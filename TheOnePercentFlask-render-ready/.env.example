# Copy to .env and adjust as needed. All of these have working defaults
# in config.py — you only need this file to override something.

FLASK_DEBUG=true
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=5000

POLL_INTERVAL_SECONDS=5
POLL_LOOKBACK_MINUTES=3

DB_PATH=data.db
HISTORY_RETENTION_HOURS=72

LOG_LEVEL=INFO
# Number of real Dukascopy candles returned to the chart on first load.
CANDLE_HISTORY_BARS=620
