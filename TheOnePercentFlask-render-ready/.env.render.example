# Render production environment reference.
# Do NOT commit real secrets. render.yaml generates SECRET_KEY automatically.

FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
HOST=0.0.0.0
PORT=10000

# Keep this conservative on Render Free to avoid unnecessary outbound traffic.
POLL_INTERVAL_SECONDS=15
POLL_LOOKBACK_MINUTES=3

CANDLE_HISTORY_BARS=620
DB_PATH=/tmp/data.db
HISTORY_RETENTION_HOURS=72
LOG_LEVEL=INFO
